tColor=#2C2C2A;fontFamily=Helvetica;whiteSpace=nowrap;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="1120" y="475" width="190" height="22" as="geometry"/></mxCell><mxCell id="c65" value="• Modo offline: capacidad técnica de la aplicación, con" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;fontColor=#2C2C2A;fontFamily=Helvetica;whiteSpace=nowrap;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="1110" y="499" width="342" height="22" as="geometry"/></mxCell><mxCell id="c66" value="sincronización posterior." style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;fontColor=#2C2C2A;fontFamily=Helvetica;whiteSpace=nowrap;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="1120" y="517" width="160" height="22" as="geometry"/></mxCell><mxCell id="c67" value="• Autorización de excepción: se modela con el evento" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;fontColor=#2C2C2A;fontFamily=Helvetica;whiteSpace=nowrap;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="1110" y="541" width="338" height="22" as="geometry"/></mxCell><mxCell id="c68" value="ExcepcionAutorizada." style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;fontColor=#2C2C2A;fontFamily=Helvetica;whiteSpace=nowrap;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="1120" y="559" width="144" height="22" as="geometry"/></mxCell><mxCell id="c69" value="2. Servicios de dominio (Domain Services)" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=18;fontColor=#2C2C2A;fontStyle=1;fontFamily=Helvetica;whiteSpace=nowrap;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="36" y="645" width="442" height="28" as="geometry"/></mxCell><mxCell id="c70" value='&lt;font style="font-size:13px;" color="#4A1B0C"&gt;&lt;b&gt;ValidadorDeCredito&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px;" color="#4A1B0C"&gt;Evalúa si el saldo vencido y la línea de&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px;" color="#4A1B0C"&gt;crédito de un Cliente Empresarial permiten&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px;" color="#4A1B0C"&gt;autorizar una Venta.&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5C4B3;strokeColor=#993C1D;strokeWidth=1.2;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="682" width="300" height="92" as="geometry"/></mxCell><mxCell id="c71" value='&lt;font style="font-size:13px;" color="#4A1B0C"&gt;&lt;b&gt;CalculadorDeDescuentos&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px;" color="#4A1B0C"&gt;Determina si se aplica 5% (cliente&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px;" color="#4A1B0C"&gt;regular) o 10% (empresarial) según el tipo&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px;" color="#4A1B0C"&gt;de cliente.&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5C4B3;strokeColor=#993C1D;strokeWidth=1.2;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="355" y="682" width="300" height="92" as="geometry"/></mxCell><mxCell id="c72" value='&lt;font style="font-size:13px;" color="#4A1B0C"&gt;&lt;b&gt;GestorDeVigencia&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px;" color="#4A1B0C"&gt;Aplica la vigencia de 5 días (regular) o 3&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px;" color="#4A1B0C"&gt;días (empresa/mayoreo) y bloquea&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px;" color="#4A1B0C"&gt;cotizaciones vencidas.&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5C4B3;strokeColor=#993C1D;strokeWidth=1.2;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="670" y="682" width="300" height="92" as="geometry"/></mxCell><mxCell id="c73" value='&lt;font style="font-size:13px;" color="#4A1B0C"&gt;&lt;b&gt;ValidadorDeDevolucion&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px;" color="#4A1B0C"&gt;Verifica el ticket y la antigüedad de la&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px;" color="#4A1B0C"&gt;compra antes de aceptar una devolución.&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5C4B3;strokeColor=#993C1D;strokeWidth=1.2;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="985" y="682" width="300" height="92" as="geometry"/></mxCell><mxCell id="c74" value='&lt;font style="font-size:13px;" color="#4A1B0C"&gt;&lt;b&gt;GeneradorDeHojaDeRuta&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px;" color="#4A1B0C"&gt;Agrupa las entregas a domicilio de un&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px;" color="#4A1B0C"&gt;chofer por código postal.&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5C4B3;strokeColor=#993C1D;strokeWidth=1.2;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1300" y="682" width="300" height="92" as="geometry"/></mxCell><mxCell id="c75" value="3. Eventos de dominio (Domain Events)" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=18;fontColor=#2C2C2A;fontStyle=1;fontFamily=Helvetica;whiteSpace=nowrap;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="36" y="803" width="414" height="28" as="geometry"/></mxCell><mxCell id="c76" value='&lt;font style="font-size:13px;" color="#4B1528"&gt;&lt;b&gt;VentaConcretada&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px;" color="#4B1528"&gt;Dispara la generación del ticket.&lt;/font&gt;' style="rounded=1;arcSize=11;whiteSpace=wrap;html=1;fillColor=#F4C0D1;strokeColor=#993556;strokeWidth=1.2;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="375" height="70" as="geometry"/></mxCell><mxCell id="c77" value='&lt;font style="font-size:13px;" color="#4B1528"&gt;&lt;b&gt;StockDescontado&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px;" color="#4B1528"&gt;Notifica a Inventario; si llega al mínimo, avisa a&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px;" color="#4B1528"&gt;Compras.&lt;/font&gt;' style="rounded=1;arcSize=11;whiteSpace=wrap;html=1;fillColor=#F4C0D1;strokeColor=#993556;strokeWidth=1.2;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="435" y="840" width="375" height="70" as="geometry"/></mxCell><mxCell id="c78" value='&lt;font style="font-size:13px;" color="#4B1528"&gt;&lt;b&gt;BackorderRegistrado&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px;" color="#4B1528"&gt;Las piezas faltantes de un pedido parcial quedan como&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px;" color="#4B1528"&gt;orden pendiente.&lt;/font&gt;' style="rounded=1;arcSize=11;whiteSpace=wrap;html=1;fillColor=#F4C0D1;strokeColor=#993556;strokeWidth=1.2;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="830" y="840" width="375" height="70" as="geometry"/></mxCell><mxCell id="c79" value='&lt;font style="font-size:13px;" color="#4B1528"&gt;&lt;b&gt;TransferenciaSolicitada&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px;" color="#4B1528"&gt;Marca el producto como «en tránsito» y bloquea su venta.&lt;/font&gt;' style="rounded=1;arcSize=11;whiteSpace=wrap;html=1;fillColor=#F4C0D1;strokeColor=#993556;strokeWidth=1.2;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1225" y="840" width="375" height="70" as="geometry"/></mxCell><mxCell id="c80" value='&lt;font style="font-size:13px;" color="#4B1528"&gt;&lt;b&gt;TransferenciaRecibida&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px;" color="#4B1528"&gt;Se confirma la recepción: libera el stock y se surte el&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px;" color="#4B1528"&gt;pedido.&lt;/font&gt;' style="rounded=1;arcSize=11;whiteSpace=wrap;html=1;fillColor=#F4C0D1;strokeColor=#993556;strokeWidth=1.2;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="924" width="375" height="70" as="geometry"/></mxCell><mxCell id="c81" value='&lt;font style="font-size:13px;" color="#4B1528"&gt;&lt;b&gt;CreditoSuspendido&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px;" color="#4B1528"&gt;Bloquea al cliente empresarial por saldo vencido o límite&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px;" color="#4B1528"&gt;excedido.&lt;/font&gt;' style="rounded=1;arcSize=11;whiteSpace=wrap;html=1;fillColor=#F4C0D1;strokeColor=#993556;strokeWidth=1.2;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="435" y="924" width="375" height="70" as="geometry"/></mxCell><mxCell id="c82" value='&lt;font style="font-size:13px;" color="#4B1528"&gt;&lt;b&gt;ExcepcionAutorizada&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px;" color="#4B1528"&gt;El gerente aprueba saltarse una regla (ej. cotización&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px;" color="#4B1528"&gt;vencida).&lt;/font&gt;' style="rounded=1;arcSize=11;whiteSpace=wrap;html=1;fillColor=#F4C0D1;strokeColor=#993556;strokeWidth=1.2;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="830" y="924" width="375" height="70" as="geometry"/></mxCell><mxCell id="c83" value='&lt;font style="font-size:13px;" color="#4B1528"&gt;&lt;b&gt;DevolucionAceptada&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px;" color="#4B1528"&gt;Dispara el reembolso por el método de pago original.&lt;/font&gt;' style="rounded=1;arcSize=11;whiteSpace=wrap;html=1;fillColor=#F4C0D1;strokeColor=#993556;strokeWidth=1.2;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1225" y="924" width="375" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>